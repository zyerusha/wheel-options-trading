# Host directory with your broker CSV exports + optional JSON config
# (accounts.json, earnings.json, fundamentals.json). Mounted read-write at
# /app/data. Uploads and market-data caches are written back here.
WHEEL_DATA_DIR=./data

# Host port for the dashboard (the container always listens on 8765 internally).
WHEEL_PORT=8765

# Only on Linux hosts whose user is not uid/gid 1000:
# WHEEL_UID=1000
# WHEEL_GID=1000

# Hosted (multi-tenant) mode -- see docker-compose.hosted.yml. Each browser
# gets its own isolated, cookie-scoped session instead of sharing
# WHEEL_DATA_DIR; nothing here persists past a session's idle TTL or a
# container restart, by design.
# WHEEL_MODE=hosted
# WHEEL_SESSION_TTL_SECONDS=7200
# WHEEL_SESSION_MAX_BYTES=262144000
# WHEEL_SESSION_MAX_FILES=100
